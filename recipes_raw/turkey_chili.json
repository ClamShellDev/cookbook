{
    "name": "Turkey Chili",
    "description": "Simple chili recipe. Serves well with corn bread or tortilla chips. Top with sliced jalapeno, sour cream, and cheese.",
    "steps": [
      {
        "step_name": "Prepare Raw Ingredients",
        "step_position": 1,
