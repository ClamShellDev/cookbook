          { "name": "oregano", "quantity": "1 teaspoon" },
          { "name": "cayenne pepper", "quantity": "1/4 teaspoon" },
          { "name": "salt", "quantity": "1/2 teaspoon" },
          { "name": "black pepper", "quantity": "1/2 teaspoon" }
        ]
      },
