          { "name": "yellow onion", "quantity": "1 med. diced" },
          { "name": "bell pepper", "quantity": "1 med. chopped" },
          { "name": "fresh garlic", "quantity": "3 cloves minced" }
        ]
      },
      {
        "step_name": "Preheat Large Pot",
        "step_position": 1,
        "step_type": "prep",
        "estimated_time": "5 minutes",
        "step_description": "Preheart a large, oiled pot on medium heat.",
        "step_ingredients": [
          { "name": "olive oil", "quantity": "1/2 tablespoon" }
        ]
      },
      {
        "step_name": "Saute Aromatics",
        "step_position": 2,
        "step_type": "cook",
        "estimated_time": "5-8 minutes",
        "step_description": "Add raw ingredients (onion, potato, pepper & garlic) to preheated pot and saute until fragrant."
      },
      {
        "step_name": "Season Chili Base",
        "step_position": 3,
